{
  "openapi": "3.1.0",
  "info": {
    "title": "Statement to Spreadsheet",
    "description": "Reads bank transaction screenshots with OpenRouter vision models, appends the signed amounts onto an account-balance formula in an Excel workbook, and keeps a per-user transaction history from which it detects recurring bills and projects the balance forward.",
    "version": "2.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness probe for the platform.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "description": "Returns 200 when the backend is up. Used by the platform's health check."
      }
    },
    "/api/me": {
      "get": {
        "summary": "Report the signed-in user's platform identity.",
        "operationId": "me_api_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          }
        },
        "description": "Reads the unspoofable X-Forwarded-Email / X-Forwarded-User headers the ingress injects when SSO is enabled. Both are null in local dev, on public paths, and when SSO is off, so this is an identity display, not an access check."
      }
    },
    "/api/config": {
      "get": {
        "summary": "Report the configured vision model and what is available in this environment.",
        "operationId": "config_api_config_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Config"
                }
              }
            }
          }
        },
        "description": "Tells the UI which OpenRouter model will read screenshots, whether an API key is present, and whether a database is configured so transaction history can be stored at all."
      }
    },
    "/api/analyze": {
      "post": {
        "summary": "Read a bank screenshot and propose which balance cell to update.",
        "description": "Sends the image to an OpenRouter vision model, returns the signed transactions, warns about duplicates already applied, and locates candidate balance cells in the supplied workbook. Writes nothing and changes nothing.",
        "operationId": "analyze_api_analyze_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_analyze_api_analyze_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/apply": {
      "post": {
        "summary": "Append the confirmed transactions to a balance cell and return the workbook.",
        "description": "Resolves the target cell, folds the signed amounts into its formula (for example =1310.25 becomes =1310.25+203.73-172.32), and returns the patched .xlsx/.xlsm with every other part of the archive preserved byte-for-byte. The change is also echoed in X-Cell / X-Formula-Before / X-Formula-After / X-Delta headers.",
        "operationId": "apply_api_apply_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_apply_api_apply_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The patched workbook, downloaded as an attachment.",
            "headers": {
              "X-Cell": {
                "description": "The cell that was changed, as Sheet!A1.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Formula-Before": {
                "description": "The formula before the change.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Formula-After": {
                "description": "The formula after the change.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Delta": {
                "description": "The signed sum that was applied.",
                "schema": {
                  "type": "string"
                }
              },
              "Content-Disposition": {
                "description": "Attachment filename for the download.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/vnd.ms-excel.sheet.macroEnabled.12": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "The workbook could not be read, or there is nothing to apply.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "404": {
            "description": "No row in the workbook matches the account label."
          },
          "409": {
            "description": "The label matches more than one row; a cell must be chosen explicitly."
          },
          "413": {
            "description": "The workbook or screenshot exceeds the size limit."
          }
        }
      }
    },
    "/api/history": {
      "get": {
        "summary": "List recent analyze/apply runs.",
        "operationId": "get_history_api_history_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "description": "A lightweight audit trail of what was applied, newest first. Never contains the workbook or the screenshot."
      }
    },
    "/api/insights": {
      "get": {
        "summary": "Detect recurring bills and project the balance forward.",
        "description": "Groups stored transactions into repeating series (subscriptions, rent, salary), flags ones expected but not seen, and projects the daily balance over the horizon. Returns ready=false with a reason when there is not enough history to be worth projecting.",
        "operationId": "get_insights_api_insights_get",
        "parameters": [
          {
            "name": "balance",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Balance"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "SGD",
              "title": "Currency"
            }
          },
          {
            "name": "account",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Account"
            }
          },
          {
            "name": "horizon_days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 45,
              "title": "Horizon Days"
            }
          },
          {
            "name": "as_of",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "As Of"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InsightsResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/affordability": {
      "post": {
        "summary": "Answer whether a purchase fits, judged on the whole projection.",
        "description": "Re-runs the forecast with the purchase inserted on its date and reads the lowest point of the planned curve, so commitments landing before the purchase date are accounted for. Returns yes / tight / no with an explanation.",
        "operationId": "post_affordability_api_affordability_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AffordabilityRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AffordabilityResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/ledger/import": {
      "post": {
        "summary": "Parse a transactions CSV, optionally storing it.",
        "description": "Detects the date / description / amount columns (or separate debit and credit columns), reports per-line problems, and stores the rows only when commit is true. Rows already stored are skipped by fingerprint, so re-importing overlapping history is a no-op.",
        "operationId": "import_csv_api_ledger_import_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_import_csv_api_ledger_import_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/ledger/rows": {
      "post": {
        "summary": "Add transactions by hand.",
        "description": "Adds rows to the caller's history without a CSV \u2014 for cash purchases or history typed in manually. Rows that duplicate existing ones are skipped.",
        "operationId": "add_rows_api_ledger_rows_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LedgerAddRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/ledger": {
      "get": {
        "summary": "List stored transactions, newest first.",
        "operationId": "list_ledger_api_ledger_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100,
              "title": "Limit"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Currency"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LedgerList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "description": "The transactions the recurring list and forecast are computed from, scoped to the signed-in user."
      },
      "delete": {
        "summary": "Erase the caller's stored transactions.",
        "description": "Deletes every ledger row belonging to the signed-in user and reports how many were removed. Screenshots and workbooks were never stored, so nothing else to erase.",
        "operationId": "clear_ledger_api_ledger_delete",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClearResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AffordabilityRequest": {
        "properties": {
          "amount": {
            "type": "string",
            "title": "Amount"
          },
          "date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date"
          },
          "balance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Balance"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "default": "SGD"
          },
          "cushion": {
            "type": "string",
            "title": "Cushion",
            "default": "0"
          },
          "horizon_days": {
            "type": "integer",
            "title": "Horizon Days",
            "default": 45
          }
        },
        "type": "object",
        "required": [
          "amount"
        ],
        "title": "AffordabilityRequest"
      },
      "AffordabilityResult": {
        "properties": {
          "verdict": {
            "type": "string",
            "title": "Verdict"
          },
          "reason": {
