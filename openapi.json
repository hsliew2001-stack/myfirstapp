            "title": "Reason"
          },
          "amount": {
            "type": "string",
            "title": "Amount"
          },
          "date": {
            "type": "string",
            "title": "Date"
          },
          "cushion": {
            "type": "string",
            "title": "Cushion"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "low": {
            "$ref": "#/components/schemas/LowPoint"
          },
          "end_balance": {
            "type": "string",
            "title": "End Balance"
          },
          "start_balance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Balance"
          },
          "forecast": {
            "$ref": "#/components/schemas/ForecastOut"
          }
        },
        "type": "object",
        "required": [
          "verdict",
          "reason",
          "amount",
          "date",
          "cushion",
          "currency",
          "low",
          "end_balance",
          "forecast"
        ],
        "title": "AffordabilityResult"
      },
      "AnalyzeResult": {
        "properties": {
          "account_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Account Hint"
          },
          "transactions": {
            "items": {
              "$ref": "#/components/schemas/Tx"
