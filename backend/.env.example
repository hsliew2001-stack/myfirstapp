# Custom environment variables & secrets. Substrait pre-creates these under the app's
# Settings so you only need to paste the real values in the portal.
#
#   NAME=value            → environment variable, prefilled
#   NAME=value   # secret → secret (write-only, masked)
#
# Do not list DATABASE_URL / JWT_SECRET / REDIS_URL here — the platform injects them.

# OpenRouter API key used to read the screenshots. Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=   # secret

# Vision model slug. Must accept image input. Free variants end in ":free" and are
# rate-limited but cost nothing.
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Optional attribution headers OpenRouter shows on its dashboard. Leave blank if unset.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Statement to Spreadsheet

# No new variables are needed for the Insights tab (recurring bills and the balance
# forecast). It uses the DATABASE_URL the platform already injects, storing transactions
# in tx_ledger (see resources/db/migration/V2__tx_ledger.sql).